# .env.exemplo — Windows 11 | Dissertacao UAN 2026
# cp .env.exemplo .env  (NUNCA fazer commit do .env)

# MongoDB Atlas (gratuito 512 MB)
# https://www.mongodb.com/cloud/atlas/register → Free (M0)
MONGODB_URI=mongodb+srv://utilizador:password@cluster.mongodb.net/dissertacao_angola

# SQL Server Express — Windows 11 local (gratuito)
# 1. Instalar: https://www.microsoft.com/pt-pt/sql-server/sql-server-downloads → Express
# 2. Instalar SSMS: https://aka.ms/ssmsfullsetup
# 3. Executar: dados/criar_data_warehouse.sql no SSMS
# 4. Instalar ODBC Driver 18: https://learn.microsoft.com/pt-pt/sql/connect/odbc/download-odbc-driver-for-sql-server
SQL_SERVER_CONN=DRIVER={ODBC Driver 18 for SQL Server};SERVER=localhost\SQLEXPRESS;DATABASE=AmeacasAngola_DW;Trusted_Connection=yes;TrustServerCertificate=yes;

# Power Automate (alertas Power BI)
# https://make.powerautomate.com
POWER_AUTOMATE_WEBHOOK=https://prod-xx.westeurope.logic.azure.com/workflows/...

# Redis (opcional — deduplicação entre ciclos)
REDIS_URL=redis://localhost:6379

# GitHub (publicar resultados — revogar após uso)
GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxx

# NÃO NECESSÁRIO (OSINT sem APIs pagas):
# TWITTER_BEARER_TOKEN  → Playwright + Nitter (gratuito)
# FACEBOOK_ACCESS_TOKEN → Playwright headless (gratuito)
# TELEGRAM_BOT_TOKEN    → t.me/s/ scraper (gratuito, sem conta)
# TELEGRAM_API_ID/HASH  → t.me/s/ scraper (gratuito, sem conta)
