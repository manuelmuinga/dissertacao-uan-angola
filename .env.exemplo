# ============================================================
# .env.exemplo — Configuração do Sistema OSINT Angola
# Dissertação UAN — Manuel Muinga 2026
# ============================================================
# INSTRUÇÕES:
#   1. Copiar para .env: cp .env.exemplo .env
#   2. Preencher os valores reais
#   3. NUNCA fazer commit do ficheiro .env (está no .gitignore)
# ============================================================

# ── Telegram MTProto (Telethon) — GRATUITO ──────────────────
# Obter em: https://my.telegram.org → API development tools
TELEGRAM_API_ID=12345678
TELEGRAM_API_HASH=abcdef1234567890abcdef1234567890

# ── MongoDB Atlas — GRATUITO (512 MB) ───────────────────────
# Criar em: https://www.mongodb.com/cloud/atlas
MONGODB_URI=mongodb+srv://utilizador:password@cluster.mongodb.net/dissertacao_angola

# ── SQL Server Express (Windows) — GRATUITO ─────────────────
# Instalar: https://www.microsoft.com/pt-pt/sql-server/sql-server-downloads
SQL_SERVER_CONN=DRIVER={ODBC Driver 18 for SQL Server};SERVER=localhost\SQLEXPRESS;DATABASE=AmeacasAngola_DW;Trusted_Connection=yes;

# ── Power Automate Webhook (alertas Power BI) ────────────────
# Criar em: https://make.powerautomate.com
POWER_AUTOMATE_WEBHOOK=https://prod-xx.westeurope.logic.azure.com/workflows/...

# ── Redis (orquestração scrapers) — OPCIONAL ────────────────
# Instalar localmente: https://redis.io/download
# Ou usar Redis Cloud gratuito: https://redis.com/try-free/
REDIS_URL=redis://localhost:6379

# ── GitHub (para publicar resultados) ───────────────────────
# Criar em: https://github.com/settings/tokens (scope: repo)
GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxx

# ============================================================
# NÃO NECESSÁRIO (arquitectura OSINT não usa APIs pagas):
#   - TWITTER_BEARER_TOKEN  → substituído por Playwright+Nitter
#   - FACEBOOK_ACCESS_TOKEN → substituído por Playwright
#   - TELEGRAM_BOT_TOKEN    → substituído por Telethon MTProto
# ============================================================
