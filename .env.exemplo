# ============================================================
# .env.exemplo — Configuração do Sistema OSINT Angola
# Dissertação UAN — Manuel Muinga 2026
# Sistema Operativo: Windows 11 (64-bit)
# ============================================================
# INSTRUÇÕES:
#   1. Copiar: cp .env.exemplo .env
#   2. Preencher os valores reais
#   3. NUNCA fazer commit do .env (está no .gitignore)
# ============================================================

# ── MongoDB Atlas — Base de dados NoSQL (gratuito 512 MB) ───
# Criar em: https://www.mongodb.com/cloud/atlas/register
MONGODB_URI=mongodb+srv://utilizador:password@cluster.mongodb.net/dissertacao_angola

# ── SQL Server Express — Data Warehouse (Windows 11 local) ──
# Instalar: https://www.microsoft.com/pt-pt/sql-server/sql-server-downloads
# Escolher: Express (gratuito, até 10 GB)
# SSMS:     https://aka.ms/ssmsfullsetup
# Executar script: dados/criar_data_warehouse.sql no SSMS
SQL_SERVER_CONN=DRIVER={ODBC Driver 18 for SQL Server};SERVER=localhost\SQLEXPRESS;DATABASE=AmeacasAngola_DW;Trusted_Connection=yes;TrustServerCertificate=yes;

# ── Power BI — Alertas automáticos via Power Automate ────────
# Criar fluxo em: https://make.powerautomate.com
# Ligação Power BI ao SQL Server: Obter Dados -> SQL Server
#   Servidor: localhost\SQLEXPRESS
#   Base de dados: AmeacasAngola_DW
#   Vista: vw_ameacas_completo
POWER_AUTOMATE_WEBHOOK=https://prod-xx.westeurope.logic.azure.com/workflows/...

# ── Redis — Controlo de duplicatas entre ciclos (opcional) ───
# Instalar: https://redis.io/download (ou Redis for Windows)
REDIS_URL=redis://localhost:6379

# ── GitHub — Publicar resultados ─────────────────────────────
# Criar em: https://github.com/settings/tokens (scope: repo)
# Revogar após uso por segurança
GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxx

# ============================================================
# NÃO NECESSÁRIO (arquitectura OSINT sem APIs pagas):
#   TWITTER_BEARER_TOKEN  → Playwright + Nitter
#   FACEBOOK_ACCESS_TOKEN → Playwright headless
#   TELEGRAM_BOT_TOKEN    → t.me/s/ scraper (sem conta)
#   TELEGRAM_API_ID/HASH  → t.me/s/ scraper (sem conta)
# ============================================================
