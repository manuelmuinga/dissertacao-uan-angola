{
  "base_de_dados": "dissertacao_angola",
  "sistema_operativo": "Windows 11 (64 bits)",
  "versao_mongodb": "MongoDB Community Server 7.0",
  "descricao": "Base de dados NoSQL para dados brutos e classificados do sistema OSINT",
  "colecoes": [
    {
      "nome": "publicacoes_brutas",
      "descricao": "Publicacoes recolhidas pelos scrapers OSINT antes do processamento",
      "indices": [
        {"campo": "id_externo", "unico": true},
        {"campo": "plataforma"},
        {"campo": "recolhido_em"},
        {"campo": "preprocessado"}
      ],
      "campos": {
        "id_externo":    "string (SHA-256 do ID original — Lei 22/11 Angola)",
        "texto":         "string (max 3000 chars)",
        "plataforma":    "string (facebook|twitter|telegram|youtube|web_*)",
        "url_origem":    "string",
        "provincia":     "string (18 provincias angolanas)",
        "data":          "string ISO 8601",
        "recolhido_em":  "string ISO 8601",
        "metodo":        "string (OSINT_scraper)",
        "classificado":  "boolean",
        "preprocessado": "boolean",
        "vistas":        "integer (opcional)"
      }
    },
    {
      "nome": "publicacoes_classificadas",
      "descricao": "Publicacoes apos classificacao pelo modelo BERT",
      "indices": [
        {"campo": "id_externo", "unico": true},
        {"campos": ["categoria", "confianca_bert"], "ordem": [1, -1]},
        {"campo": "alerta_emitido"},
        {"campo": "provincia"},
        {"campo": "classificado_em"}
      ],
      "campos": {
        "id_externo":      "string (SHA-256)",
        "id_anonimizado":  "string (SHA-256 16 chars)",
        "texto_processado":"string (apos PLN)",
        "categoria":       "string (Normal|Desinformacao|Discurso de Odio|Mobilizacao Hostil)",
        "confianca_bert":  "float (0.0-1.0)",
        "alerta_emitido":  "boolean",
        "plataforma":      "string",
        "provincia":       "string",
        "data":            "string ISO 8601",
        "classificado_em": "string ISO 8601",
        "modelo_ia":       "string (BERT-BERTimbau)",
        "segundos_detecao":"integer"
      }
    },
    {
      "nome": "logs_scrapers",
      "descricao": "Registo de cada ciclo de recolha OSINT",
      "indices": [
        {"campo": "timestamp"},
        {"campo": "plataforma"}
      ],
      "campos": {
        "timestamp":      "string ISO 8601",
        "plataforma":     "string",
        "total_recolhido":"integer",
        "inseridos":      "integer",
        "duracao_seg":    "float",
        "erro":           "string (null se sem erro)"
      }
    }
  ]
}
