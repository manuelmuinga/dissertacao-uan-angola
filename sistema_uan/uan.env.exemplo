# Copie este ficheiro para uan.env (na mesma pasta) e preencha os valores.
# O uan.env não vai para o Git. Uma variável definida com `set` no cmd prevalece sobre este ficheiro.

# Pasta do modelo BERTimbau guardado no Colab (deve conter config.json, pesos e tokenizer)
UAN_MODELO=C:\modelos\bertimbau_uan_v13_s42

# Segredo dos pseudónimos dos autores: uma frase longa que só você conhece. Não a mude depois de importar dados.
UAN_SEGREDO_HASH=

# Chave da API em /api (deixe vazio para desactivar a API)
UAN_CHAVE_API=

# Opcionais
# UAN_BD=dados\sistema.db
# UAN_MAX_LENGTH=256
# UAN_LOTE=32
# UAN_DISPOSITIVO=auto
# UAN_DIAS_CONSERVACAO=180
# UAN_HORAS_SESSAO=8
# UAN_MAX_UPLOAD_MB=20
# UAN_COOKIE_SEGURO=0
